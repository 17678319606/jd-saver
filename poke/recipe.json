{
  "name": "jd-saver",
  "version": "0.2.0",
  "description": "京东省钱助手 - 搜商品、查券、转链、凑单、降价提醒、差评过滤",
  "tools": [
    "jd_get_coupon",
    "jd_generate_promo_link",
    "jd_find_deals",
    "jd_set_price_alert",
    "jd_query_history",
    "jd_update_min_price",
    "jd_search_goods",
    "jd_query_comment_quality",
    "jd_get_combo_scheme"
  ],
  "env": {
    "JD_APP_KEY": { "type": "secret", "required": true },
    "JD_APP_SECRET": { "type": "secret", "required": true },
    "JD_PID": { "type": "string", "required": true },
    "DB_PATH": { "type": "string", "default": "./jd_saver.db" },
    "POKE_WEBHOOK_URL": { "type": "string", "required": false, "description": "降价提醒推送地址（可选）" }
  }
}
